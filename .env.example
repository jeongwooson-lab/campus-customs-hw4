# Set this to the folder containing campus_customs.db and products/
DATA_DIR=/absolute/path/to/data
# Use an OpenAI API key for PydanticAI answers. Without one, verified local catalogue answers still work.
OPENAI_API_KEY=your_openai_key_here
# Or use the Portkey gateway instead of a direct OpenAI key.
PORTKEY_API_KEY=your_portkey_key_here
PORTKEY_PROVIDER=your_provider_slug
PORTKEY_BASE_URL=https://api.portkey.ai/v1
AI_MODEL=openai:gpt-5.6
SESSION_SECRET=replace_with_a_long_random_string
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
